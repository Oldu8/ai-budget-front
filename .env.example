# Copy to .env or .env.local and fill values.
# Expo loads EXPO_PUBLIC_* at build time (no restart needed).
# Use in code via constants/env.ts (env.apiUrl, env.appEnv)

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=
# Required when backend has API_SECRET. Must match backend value. Sent as X-API-Key header.
EXPO_PUBLIC_API_SECRET=